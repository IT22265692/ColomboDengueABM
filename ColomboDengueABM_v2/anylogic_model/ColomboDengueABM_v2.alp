		<!--   =========  Parameter Variation Experiment   ========  -->
		<ParamVariationExperiment ActiveObjectClassId="1784351177070">
			<Id>1784371539581</Id>
			<Name><![CDATA[ParamVar_Weather]]></Name>
			<CommandLineArguments><![CDATA[]]></CommandLineArguments>
			<MaximumMemory>4096</MaximumMemory>
			<RandomNumberGenerationType>randomSeed</RandomNumberGenerationType>
			<CustomGeneratorCode>new Random()</CustomGeneratorCode>
			<AfterSimulationRunCode><![CDATA[// Print to Console
traceln("weatherYear=" + root.weatherYear +
        " totalInfections=" + root.totalInfectionsThisRun);

for (String zn : root.infectionsByZone.keySet()) {
    traceln("  zone=" + zn +
            " infections=" + root.infectionsByZone.get(zn));
}

// Save to CSV
try {

    java.io.File file = new java.io.File("WeatherExperimentResults.csv");
    boolean newFile = !file.exists();

    java.io.FileWriter fw = new java.io.FileWriter(file, true);

    // Write header only once
    if (newFile) {
        fw.write("WeatherYear,TotalInfections,Zone,ZoneInfections\n");
    }

    for (String zn : root.infectionsByZone.keySet()) {

        fw.write(
            root.weatherYear + "," +
            root.totalInfectionsThisRun + "," +
            zn + "," +
            root.infectionsByZone.get(zn) + "\n"
        );

    }

    fw.close();

}
catch (Exception e) {
    e.printStackTrace();
}]]></AfterSimulationRunCode>
