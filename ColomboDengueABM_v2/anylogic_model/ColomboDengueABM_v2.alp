					<X>-150</X><Y>850</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Properties TriggerType="timeout" Mode="cyclic">
						<Timeout Class="CodeUnitValue">
							<Code><![CDATA[1]]></Code>
							<Unit Class="TimeUnits"><![CDATA[DAY]]></Unit>
						</Timeout>
						<Rate Class="CodeUnitValue">
							<Code><![CDATA[1]]></Code>
							<Unit Class="RateUnits"><![CDATA[PER_DAY]]></Unit>
						</Rate>
						<Id>1784353823584</Id>
						<OccurrenceAtTime>true</OccurrenceAtTime>
						<OccurrenceDate>1784361600000</OccurrenceDate>
						<OccurrenceTime Class="CodeUnitValue">
							<Code><![CDATA[0]]></Code>
							<Unit Class="TimeUnits"><![CDATA[DAY]]></Unit>
						</OccurrenceTime>
						<RecurrenceCode Class="CodeUnitValue">
							<Code><![CDATA[1]]></Code>
							<Unit Class="TimeUnits"><![CDATA[DAY]]></Unit>
						</RecurrenceCode>
						<Condition><![CDATA[false]]></Condition>
					</Properties>
					<Action><![CDATA[// --- Look up this week's weather per zone ---
java.text.SimpleDateFormat sdf = new java.text.SimpleDateFormat("yyyy-MM-dd");
java.util.Calendar startCal = java.util.Calendar.getInstance();
startCal.set(2015, java.util.Calendar.JANUARY, 1, 0, 0, 0);
startCal.set(java.util.Calendar.MILLISECOND, 0);

long daysSinceStart = (long) time();
long weekIndex;

if (useSingleYearWeather) {
    // Repeat just one chosen year's weather for the whole run
    java.util.Calendar yearStart = java.util.Calendar.getInstance();
    yearStart.set(weatherYear, java.util.Calendar.JANUARY, 1, 0, 0, 0);
    yearStart.set(java.util.Calendar.MILLISECOND, 0);
    long yearOffsetDays = (yearStart.getTimeInMillis() - startCal.getTimeInMillis()) / (1000L*60*60*24);
    long yearOffsetWeekIndex = yearOffsetDays / 7;

    long daysIntoYearCycle = daysSinceStart % 364;
    long weekIndexWithinYear = daysIntoYearCycle / 7;

    weekIndex = yearOffsetWeekIndex + weekIndexWithinYear;
} else {
    // Default: cycle through the full real 2015-2025 weather history
    weekIndex = daysSinceStart / 7;
}

java.util.Calendar cal = (java.util.Calendar) startCal.clone();
cal.add(java.util.Calendar.DAY_OF_YEAR, (int)(weekIndex * 7));
String todayStr = sdf.format(cal.getTime());

for (Zone z : zones) {
    String key = z.zoneName + "|" + todayStr;
    double[] w = weatherLookup.get(key);
    if (w != null) {
        z.todayTemp = w[0];
        z.todayRainfall = w[1];
    }
}

// --- Advance SEIR state for every human ---
for (Human h : humans) {
    if (h.seirState == 1) {
        h.stateTimer++;
        if (h.stateTimer >= h.myIncPeriod) {
            h.seirState = 2;
            h.stateTimer = 0;
            h.myInfPeriod = uniform(humanInfMin, humanInfMax);
        }
    } else if (h.seirState == 2) {
        h.stateTimer++;
        if (h.stateTimer >= h.myInfPeriod) {
            h.seirState = 3;
            h.stateTimer = 0;
        }
    }
}
// Waning cross-serotype immunity (recovery from one serotype doesn't protect against the other 3)
double dailyWaningProb = 0.0015; // ~2-year average duration of cross-protection
for (Human h : humans) {
    if (h.seirState == 3) {
        if (uniform(0,1) < dailyWaningProb) {
            h.seirState = 0;
        }
    }
}
totalBitesToday = 0;
totalImports = 0;

// --- Bite exposure ---
for (Zone z : zones) {
    int totalMosquitoes = z.mosqSusceptible + z.mosqInfectious;
    double infectiousRatio = (totalMosquitoes > 0) ? (double) z.mosqInfectious / totalMosquitoes : 0;

    double optimalTemp = 29.0;
    double bitingRate = Math.max(0, 1 - Math.pow((z.todayTemp - optimalTemp) / 10.0, 2));
    double bitesPerPersonToday = bitingRate * infectiousRatio;

    for (Human h : humans) {
        Zone currentZone = h.isCommuter ? h.workZone : h.homeZone;
        if (currentZone == z && h.seirState == 0) {
            if (uniform(0,1) < bitesPerPersonToday) {
                double transmissionProb = uniform(biteTransMin, biteTransMax);
                if (uniform(0,1) < transmissionProb) {
                    h.seirState = 1;
                    h.stateTimer = 0;
                    h.myIncPeriod = uniform(humanIncMin, humanIncMax);
                    totalBitesToday++;
                    totalInfectionsThisRun++;
                    infectionsByZone.put(z.zoneName, infectionsByZone.get(z.zoneName) + 1);
                }
            }
        }
    }
}

// --- Mosquito survival, replenishment, new infections ---
for (Zone z : zones) {
    double optimalTemp = 29.0;
    double survivalProb = 0.9 - 0.01 * Math.abs(z.todayTemp - optimalTemp) - 0.001 * z.todayRainfall;
    survivalProb = Math.max(0.5, Math.min(0.95, survivalProb));

    int mosqBeforeUpdate = z.mosqSusceptible + z.mosqInfectious;
    z.mosqSusceptible = (int)(z.mosqSusceptible * survivalProb);
    z.mosqInfectious = (int)(z.mosqInfectious * survivalProb);
    int mosqAfterDeaths = z.mosqSusceptible + z.mosqInfectious;
    int newBirths = mosqBeforeUpdate - mosqAfterDeaths;
    z.mosqSusceptible += newBirths;

    int infectiousHumansInZone = 0;
    for (Human h : humans) {
        Zone currentZone = h.isCommuter ? h.workZone : h.homeZone;
        if (currentZone == z && h.seirState == 2) {
            infectiousHumansInZone++;
        }
    }

    double humanInfectiousRatio = (z.population / populationScaleFactor > 0)
        ? (double) infectiousHumansInZone / (z.population / populationScaleFactor) : 0;

    double optimalTemp2 = 29.0;
    double bitingRateMosq = Math.max(0, 1 - Math.pow((z.todayTemp - optimalTemp2) / 10.0, 2));
    double newMosqInfections = z.mosqSusceptible * bitingRateMosq * humanInfectiousRatio;

    int newlyInfectedMosq = (int) newMosqInfections;
    if (uniform(0,1) < (newMosqInfections - newlyInfectedMosq)) {
        newlyInfectedMosq++;
    }
    z.mosqSusceptible = Math.max(0, z.mosqSusceptible - newlyInfectedMosq);
    z.mosqInfectious += newlyInfectedMosq;
}

// --- Case importation (small linked cluster) ---
double importRatePerZonePerDay = 0.01;
int importClusterSize = 20;
for (Zone z : zones) {
    if (uniform(0,1) < importRatePerZonePerDay) {
        int imported = 0;
        for (Human h : humans) {
            if (imported >= importClusterSize) break;
            Zone currentZone = h.isCommuter ? h.workZone : h.homeZone;
            if (currentZone == z && h.seirState == 0) {
                h.seirState = 1;
                h.stateTimer = 0;
                h.myIncPeriod = uniform(humanIncMin, humanIncMax);
                totalImports++;
                totalInfectionsThisRun++;
                infectionsByZone.put(z.zoneName, infectionsByZone.get(z.zoneName) + 1);
                imported++;
            }
        }
    }
}]]></Action>
				</Event>
			</Events>
			<Functions>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1784354169027</Id>
					<Name><![CDATA[countInfectious]]></Name>
					<X>-150</X><Y>900</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[int count = 0;
for (Human h : humans) {
    if (h.seirState == 2) {
        count++;
    }
}
return count;]]></Body>
				</Function>
