<Model>
	<Id>1784351177021</Id>
	<Name><![CDATA[ColomboDengueABM_v2]]></Name>
	<EngineVersion>6</EngineVersion>
	<JavaPackageName><![CDATA[colombodengueabm_v2]]></JavaPackageName>
	<ModelTimeUnit><![CDATA[Day]]></ModelTimeUnit>
	<Folders>
	</Folders>
	<ActiveObjectClasses>
		<!--   =========   Active Object Class   ========  -->
		<ActiveObjectClass>
			<Id>1784351177070</Id>
			<Name><![CDATA[Main]]></Name>
			<StartupCode><![CDATA[infectionsByZone = new HashMap<String, Integer>();
for (Zone z : zones) {
    infectionsByZone.put(z.zoneName, 0);
}
// --- Create human population, proportionally by zone, with commuter assignment ---
int totalRealPopulation = 0;
for (Zone z : zones) {
    totalRealPopulation += z.population;
}

int totalHumanAgents = totalRealPopulation / populationScaleFactor;

for (int i = 0; i < totalHumanAgents; i++) {
    double r = uniform(0, totalRealPopulation);
    double cumulative = 0;
    Zone chosenHome = null;
    for (Zone z : zones) {
        cumulative += z.population;
        if (r <= cumulative) {
            chosenHome = z;
            break;
        }
    }

    boolean commuter = uniform(0, 1) < commutingShare;
    Zone chosenWork = chosenHome;
    if (commuter) {
        do {
            chosenWork = zones.get(uniform_discr(0, zones.size() - 1));
        } while (chosenWork == chosenHome);
    }

    boolean seedInfectious = uniform(0,1) < 0.005;

    Human h = add_humans(commuter, chosenHome, chosenWork, seedInfectious);
    if (seedInfectious) {
        h.seirState = 2;
        h.myInfPeriod = uniform(humanInfMin, humanInfMax);
        totalInfectionsThisRun++;
    } else {
        h.seirState = 0;
    }
}

// --- Seed aggregate mosquito counts per zone ---
for (Zone z : zones) {
    int totalMosquitoesInZone = (z.population / populationScaleFactor) * mosquitoesPerPerson;
    z.mosqInfectious = (int)(totalMosquitoesInZone * 0.01);
    z.mosqSusceptible = totalMosquitoesInZone - z.mosqInfectious;
}

// --- Load weekly weather into memory ---
weatherLookup = new HashMap<String, double[]>();
java.text.SimpleDateFormat sdf = new java.text.SimpleDateFormat("yyyy-MM-dd");
List<Tuple> weatherRows = selectFrom(temperature_and_rainfall_per_zone_weekly).list();
for (Tuple row : weatherRows) {
    String zoneVal = row.get(temperature_and_rainfall_per_zone_weekly.zone);
    java.util.Date dateVal = row.get(temperature_and_rainfall_per_zone_weekly.week_start);
    double tempVal = row.get(temperature_and_rainfall_per_zone_weekly.temp_celsius);
    double rainVal = row.get(temperature_and_rainfall_per_zone_weekly.rainfall_mm);

    String key = zoneVal + "|" + sdf.format(dateVal);
    weatherLookup.put(key, new double[]{ tempVal, rainVal });
}]]></StartupCode>
