]]></BeforeEachExperimentRunCode>
			<AfterSimulationRunCode><![CDATA[histogram0_data.add( root.totalInfectionsThisRun );
histogram0_data.add(root.totalInfectionsThisRun);

try {
    java.io.FileWriter fw = new java.io.FileWriter("MonteCarloResults.csv", true);

    fw.write(
        root.totalInfectionsThisRun + "," +
        root.totalBitesToday + "," +
        root.totalImports + "\n"
    );

    fw.close();
}
catch(Exception e) {
    e.printStackTrace();
}
]]></AfterSimulationRunCode>
