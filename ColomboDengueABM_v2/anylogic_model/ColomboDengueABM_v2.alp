			<InitialSetupCode><![CDATA[try {
    java.io.FileWriter fw = new java.io.FileWriter("MonteCarloResults.csv");

    fw.write("TotalInfections,TotalBites,TotalImports\n");

    fw.close();
}
catch(Exception e) {
    e.printStackTrace();
}]]></InitialSetupCode>
			<MaximumMemory>4096</MaximumMemory>
